[package]
name = "pwd-grp"
version = "0.1.1"
edition = "2018"
license="MIT"
authors=["Ian Jackson <ijackson@chiark.greenend.org.uk>",
         "and the contributors to Rust pwd-grp"]
description="Access Unix passwords and groups"
homepage = "https://gitlab.torproject.org/tpo/core/rust-pwd-grp"
repository = "https://gitlab.torproject.org/tpo/core/rust-pwd-grp"
rust-version = "1.54"

[features]
default = ["minimal-1"]
full = ["default", "serde"]
minimal-1 = []

# Internal use.  (Has no effect without #[cfg(test)] so is in fact additive.
test-with-lmock = []

[dependencies]
derive-adhoc = ">=0.6, <0.8"
libc = "0.2.143"
paste = "1"
thiserror = "1"

serde = { version = "1.0.106", optional = true, features = ["derive"] }

[dev-dependencies]
rustversion = "1"
